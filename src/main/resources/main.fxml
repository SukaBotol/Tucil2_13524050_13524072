<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="stima.viewer">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>

    <HBox spacing="10.0">
        <Button fx:id="chooseButton" text="Choose .obj file" onAction="#chooseObjFile"/>
        <Label text="Depth"/>
        <TextField fx:id="depthField" prefColumnCount="5"/>
        <Label text="Output"/>
        <TextField fx:id="outputField" prefColumnCount="14"/>
        <Button fx:id="buildButton" text="Build octree" onAction="#buildOctree"/>
    </HBox>

    <Label fx:id="selectedFileLabel" text="No .obj file selected"/>
    <TextArea fx:id="outputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
</VBox>
